#!/usr/bin/env bash
# `hermes` on the host → the Hermes CLI of the active release (/opt/hermes), as the gateway runs it.
#
# Same user, config and environment as the gateway and `command-center hermes chat` (agent_exec):
# the operator user, /etc/hermes/agent.env, HOME=/opt/data/home (the agent's own CLI logins),
# HERMES_HOME=/opt/data. cwd = the current directory when it is inside the shared workspace, else
# the workspace root.
#
#   hermes                        # interactive CLI
#   hermes chat --resume <id>     # any hermes subcommand / flags
#   hermes chat -q "…" --oneshot  # scripts / pipes work too
#
# /usr/local/bin/hermes → /srv/command-center/bin/hermes (hermes-host.sh). Root or the operator user.
set -euo pipefail

# shellcheck disable=SC1091
. "$(dirname "$(readlink -f "$0")")/../lib/common.sh"
agent_wrapper_init
hermes_installed || die "no active Hermes release in $HERMES_CURRENT (sudo command-center hermes status)"

# `hermes update` is refused by the release itself (/etc/hermes/image-provenance.json: the command
# center owns updates), with a bare "hermes update" as its only explanation. Say what to run instead.
if [ "${1:-}" = update ]; then
  cat >&2 <<'MSG'
Hermes is updated by the command center, not in place: each upstream commit is built as its own
release, smoke-tested, switched to once Hermes is idle, and rolled back if it does not stay healthy.

  sudo command-center update --force     # update now (latest main): build, switch, verify
  sudo command-center update check       # build and report what would change; switches nothing
  sudo command-center hermes status      # active release, previous one, health
  sudo command-center hermes rollback    # back to the previous release (pauses automatic updates)

Automatic: every night at 04:00 (hermes-update.timer).
MSG
  exit 2
fi

# Hermes Desktop (SSH mode) writes a one-shot token under the login HOME
# ($HOME/.hermes/desktop-ssh/<id>/<nonce>.token) and passes it to `serve`, which only accepts it
# under its own HOME — /opt/data/home once agent_exec re-homes it. Move the token there (the
# server reads then unlinks it) and point the flag at the new path.
args=("$@")
for i in "${!args[@]}"; do
  [ "${args[$i]}" = --ssh-session-token-file ] || continue
  src="${args[$((i + 1))]:-}"
  case "$src" in "$HOME"/.hermes/desktop-ssh/*/*.token) ;; *) break ;; esac
  dst_root=/opt/data/home/.hermes/desktop-ssh
  dst_dir="$dst_root/$(basename "$(dirname "$src")")"
  if ! (umask 077 && mkdir -p "$dst_dir" && chmod 700 "$dst_root" "$dst_dir"); then
    die "cannot prepare $dst_dir for the Desktop SSH token"
  fi
  mv -f "$src" "$dst_dir/" || die "cannot move the Desktop SSH token to $dst_dir"
  args[i + 1]="$dst_dir/$(basename "$src")"
  break
done

# agent_exec starts from `env -i`, which drops the markers Desktop sets on its spawn
# (`exec env HERMES_DESKTOP=1 [HERMES_GUEST_ONBOARDING=1] hermes serve …`). Without
# HERMES_DESKTOP=1 the loopback backend is not recognised as Desktop-owned: the dashboard auth
# gate engages and refuses the per-spawn session token on /api/ws. Forward them when set.
#
# Same for the variables an Orca terminal sets for its agent-status hooks: the orca-status plugin
# (linked into /opt/data/plugins by orca.sh) reads them to post working / done / waiting to Orca
# on loopback; without them it stays silent and Orca shows the pane as done. Only what the plugin
# reads — not ORCA_HISTFILE, ORCA_PORT, ORCA_PAIRING… (the endpoint file holds the current port).
passthrough=()
for var in HERMES_DESKTOP HERMES_GUEST_ONBOARDING \
  ORCA_AGENT_HOOK_ENDPOINT ORCA_AGENT_HOOK_PORT ORCA_AGENT_HOOK_TOKEN ORCA_AGENT_HOOK_ENV \
  ORCA_AGENT_HOOK_VERSION ORCA_AGENT_LAUNCH_TOKEN \
  ORCA_PANE_KEY ORCA_TAB_ID ORCA_WORKTREE_ID; do
  [ -n "${!var:-}" ] && passthrough+=("$var=${!var}")
done

# No `exec`: this script — a process named `hermes` — stays in the terminal's foreground, which is
# how herdr recognises the agent and tracks idle / working / blocked. Its exit status is the CLI's.
if [ "${#passthrough[@]}" -gt 0 ]; then
  agent_exec env "${passthrough[@]}" hermes "${args[@]}"
else
  agent_exec hermes "${args[@]}"
fi
