#!/usr/bin/env bash
# `hermes` on the host → the Hermes CLI inside the hermes-agent container.
#
# Same user, HOME and config as the gateway and `command-center hermes chat` (agent_exec):
# runtime uid, HOME=/opt/data/home, HERMES_HOME=/opt/data. cwd = the current directory when it
# is inside the shared workspace (same absolute path in the container), else the workspace root.
#
#   hermes                        # interactive CLI
#   hermes chat --resume <id>     # any hermes subcommand / flags
#   hermes chat -q "…" --oneshot  # scripts / pipes work too (no TTY allocated when not on a terminal)
#
# /usr/local/bin/hermes → /srv/command-center/bin/hermes (install.sh). Needs root or the docker group.
set -euo pipefail

# shellcheck disable=SC1091
. "$(dirname "$(readlink -f "$0")")/../lib/common.sh"
load_env

[ "$(docker inspect -f '{{.State.Running}}' hermes-agent 2>/dev/null)" = true ] \
  || die "hermes-agent is not running (sudo command-center hermes status)"

cwd="$HERMES_WORKSPACE_DIR"
here="$(pwd -P 2>/dev/null || true)"
case "$here/" in "$HERMES_WORKSPACE_DIR"/*) cwd="$here" ;; esac

tty=(-i)
[ -t 0 ] && [ -t 1 ] && tty=(-it)

# No `exec`: this script — a process named `hermes` — stays in the terminal's foreground next to
# docker, which is how herdr recognises the agent and tracks idle / working / blocked (update.sh
# waits for it). Its exit status is docker's, i.e. the CLI's.
docker exec "${tty[@]}" -u "${HERMES_UID}:${HERMES_GID}" -e HOME=/opt/data/home \
  -e TERM="${TERM:-xterm}" ${COLORTERM:+-e COLORTERM="$COLORTERM"} \
  -w "$cwd" hermes-agent hermes "$@"
