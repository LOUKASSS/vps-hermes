[Unit]
Description=Nightly Hermes stack update, 04:00 (images + coding CLIs, tested before the swap, auto-rollback; after the 02:00 reboot window and the 03:00 backup)

[Timer]
OnCalendar=*-*-* 04:00:00
# No catch-up after downtime: a missed night is simply done the next night, never in the daytime.
Persistent=false

[Install]
WantedBy=timers.target
