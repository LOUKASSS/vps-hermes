# ── Workspace endpoint ────────────────────────────────────────────
# FQDN served by Traefik. Cloudflare A record → the VPS Tailscale IP, DNS-only (grey cloud):
# the workspace is tailnet-only, TLS comes from a DNS-01 challenge (no inbound port needed).
WORKSPACE_HOST=workspace.example.com
# Let's Encrypt registration email
ACME_EMAIL=you@example.com
# Cloudflare API token with Zone:DNS:Edit on the zone (DNS-01 challenge)
CF_DNS_API_TOKEN=

# ── Secrets (install.sh generates them if empty) ─────────────────
# Bearer for the gateway API (8642); the workspace passes it as HERMES_API_TOKEN
API_SERVER_KEY=
# Login password of the workspace web UI
HERMES_PASSWORD=

# ── Hermes Desktop (Settings → Gateways → Remote gateway → http://<tailscale-ip>:9120) ──
DESKTOP_USERNAME=admin
# install.sh generates these if empty
DESKTOP_PASSWORD=
DESKTOP_SECRET=
DESKTOP_PORT=9120
# Host IP to publish the Desktop backend (9120) on, and the address Orca advertises to its
# clients (orca.sh). install.sh sets the Tailscale IP when it is empty/loopback and keeps any
# other value you set. Never 0.0.0.0 on a VPS without a firewall in front.
DESKTOP_BIND=127.0.0.1

# ── Host storage ─────────────────────────────────────────────────
HERMES_DATA_DIR=/srv/hermes/data
HERMES_WORKSPACE_DIR=/srv/hermes/workspace
TRAEFIK_DIR=/srv/hermes/traefik

# ── Ownership: VPS user who owns /srv/hermes/* (install.sh: uid of `hermes` if it exists, else SUDO_UID)
HERMES_UID=1000
HERMES_GID=1000

# ── Obsidian Sync (optional) ─────────────────────────────────────
# Vault directory under /srv/hermes/workspace (→ /workspace/<dir> for the agent, /vault for the sync client)
OBSIDIAN_VAULT_DIR=vault
# Obsidian credentials/config (HOME of the sync client)
OBSIDIAN_DIR=/srv/hermes/obsidian
# npm version of obsidian-headless baked into the sidecar image (latest or e.g. 1.2.3)
OBSIDIAN_HEADLESS_VERSION=latest
# Comma list of enabled optional services; `auth.sh obsidian` appends its profile
COMPOSE_PROFILES=

# ── Orca remote server on the host (optional, `orca.sh install`; systemd orca.service) ─────
# Release tag (e.g. v1.4.204) or latest. With latest, orca.sh update resolves the current GitHub
# release tag and reinstalls only when it changed; the AppImage sha512 is verified either way.
ORCA_VERSION=latest
# "" = desktop/runtime pairing link, "--mobile-pairing" = mobile QR/link (orca.sh pair mobile)
ORCA_PAIRING=
# Listening port (advertised on DESKTOP_BIND)
ORCA_PORT=6768

# ── Resources (VPS 8 vCPU / 16 GB: agent gets 10g + 6 CPUs, the rest stays for
#    host, traefik, workspace UI (~2 GB Node heap) and obsidian-sync) ──
AGENT_MEM_LIMIT=10g
AGENT_CPUS=6
# hermes-workspace (Node UI). traefik 256m, hermes-dashboard 1g, obsidian-sync 1g are fixed in compose.
# Orca runs on the host (orca.service, MemoryMax=ORCA_MEM_LIMIT).
WORKSPACE_MEM_LIMIT=3g
ORCA_MEM_LIMIT=3g
TZ=Europe/Paris

# ── Backups → Backblaze B2 (backup.sh setup fills these) ─────────
# Automation flags (files, not variables): touch .maintenance to pause heal.sh;
# .update-hold is written by `update.sh rollback` and removed by `update.sh resume`.
# Bucket + application key restricted to it (listBuckets, listFiles, readFiles, writeFiles, deleteFiles)
B2_BUCKET=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# Repository encryption password (generated). LOSING IT = LOSING THE BACKUPS. Keep a copy elsewhere.
RESTIC_PASSWORD=
# Defaults to b2:$B2_BUCKET:hermes
RESTIC_REPOSITORY=
RESTIC_IMAGE=restic/restic:latest
