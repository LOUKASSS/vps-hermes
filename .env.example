# ── Dashboard endpoint ────────────────────────────────────────────
# FQDN served by Traefik → the Hermes dashboard (web UI + Hermes Desktop backend, basic auth
# DESKTOP_USERNAME/PASSWORD below). Resolved for the tailnet by the stack's own DNS (see DNS_ZONE);
# TLS comes from a Cloudflare DNS-01 challenge (the zone must be on Cloudflare, no inbound port,
# no public A record needed). Tailnet-only.
HERMES_HOST=hermes.example.com
# Zone the stack's DNS answers with the VPS Tailscale IP: this name and everything under it
# (e.g. example.com's hermes.example.com → app1.hermes.example.com, app2.hermes.example.com …
# for your own projects behind this Traefik).
# Must contain HERMES_HOST. Empty = HERMES_HOST itself. Tailscale admin console → DNS →
# Nameservers → Add → <Tailscale IP of the VPS>, "Restrict to domain" = DNS_ZONE.
DNS_ZONE=
# Let's Encrypt registration email
ACME_EMAIL=you@example.com
# Cloudflare API token with Zone:DNS:Edit + Zone:Zone:Read on the zone (DNS-01 challenge)
CF_DNS_API_TOKEN=

# ── Secrets (install.sh generates them if empty) ─────────────────
# Bearer for the gateway HTTP API (127.0.0.1:8642 inside the agent container)
API_SERVER_KEY=

# ── Dashboard login (browser at https://HERMES_HOST, and Hermes Desktop: Settings → Gateways →
#    Remote gateway → https://HERMES_HOST or http://<tailscale-ip>:9120) ──
# Passed to the container as HERMES_DASHBOARD_BASIC_AUTH_USERNAME/PASSWORD/SECRET (env beats
# config.yaml dashboard.basic_auth). Hermes then layers its external secret sources (config.yaml
# secrets.*, e.g. Bitwarden Secrets Manager) over the env: if one defines those keys, IT wins and
# the values below are ignored — install.sh tests the login and tells you which are in effect.
DESKTOP_USERNAME=admin
# install.sh generates these if empty (DESKTOP_SECRET signs the login cookies)
DESKTOP_PASSWORD=
DESKTOP_SECRET=
DESKTOP_PORT=9120
# Host IP to publish Traefik (80/443), the dashboard (9120) and the DNS (53) on, the
# address the DNS answers with, and the address Orca advertises to its clients (orca.sh).
# install.sh sets the current Tailscale IP when it is empty, loopback or a stale 100.x address,
# and keeps any other value you set.
# Never 0.0.0.0 on a VPS without a firewall in front.
DESKTOP_BIND=127.0.0.1

# ── Host storage: one folder per project under /srv ──────────────
#   /srv/command-center (this repo)  /srv/hermes (agent)  /srv/orca  /srv/helios  /srv/workspace
# Agent HOME (/opt/data in the container)
HERMES_DATA_DIR=/srv/hermes/data
# Shared projects: mounted in hermes-agent at this SAME path (+ /workspace alias); Orca and herdr
# sessions start here. Owned by HERMES_UID, like everything the agent writes.
HERMES_WORKSPACE_DIR=/srv/workspace
# Traefik ACME store (root-owned, 0600)
TRAEFIK_DIR=/srv/command-center/state/traefik
# Subnet of the shared `proxy` network (Helios' tinyauth trusts X-Forwarded-* only from it)
PROXY_SUBNET=172.20.0.0/16

# ── Ownership: VPS user who owns /srv/* (install.sh: uid of `hermes` if it exists, else SUDO_UID)
HERMES_UID=1000
HERMES_GID=1000

# ── PostgreSQL (hermes-postgres, always on) ──────────────────────
# Credentials the agent and your desktop client use (install.sh generates the password).
POSTGRES_USER=hermes
POSTGRES_PASSWORD=
POSTGRES_DB=hermes
# Host port on DESKTOP_BIND (tailnet only) for psql / DBeaver / Grafana from your devices.
POSTGRES_PORT=5432
# data/ = live cluster (not backed up), dumps/ = daily pg_dumpall.sql.gz (backed up, 7 kept)
POSTGRES_DIR=/srv/hermes/postgres

# ── Obsidian Sync (optional) ─────────────────────────────────────
# Vault directory under HERMES_WORKSPACE_DIR (same path for the agent, /vault for the sync client)
OBSIDIAN_VAULT_DIR=vault
# Obsidian credentials/config (HOME of the sync client)
OBSIDIAN_DIR=/srv/hermes/obsidian
# Pin of obsidian-headless installed into the sidecar volume (not `latest`: the stamp would never advance).
OBSIDIAN_HEADLESS_VERSION=0.0.14
# Comma list of enabled optional services; `auth.sh obsidian` appends its profile
COMPOSE_PROFILES=

# ── Orca remote server on the host (optional, `orca.sh install`; systemd orca.service) ─────
# Release tag (e.g. v1.4.204) or latest. With latest, orca.sh update resolves the current GitHub
# release tag and reinstalls only when it changed; the AppImage sha512 is verified either way.
ORCA_VERSION=latest
# "" = desktop/runtime pairing link, "--mobile-pairing" = mobile QR/link (orca.sh pair mobile)
ORCA_PAIRING=
# Listening port (advertised on DESKTOP_BIND)
ORCA_PORT=6768
# Orca runs as user `hermes` (same uid as harden.sh / the agent binds). No dedicated `orca` user.
# HOME is /srv/orca (0700, NOT /home/hermes, NOT mounted in the agent). Sessions cwd is
# HERMES_WORKSPACE_DIR (shared projects). GIT_CONFIG_COUNT in /etc/orca.env overrides repo hooks.
ORCA_HOME=/srv/orca

# ── Helios (optional, `command-center helios deploy`) ─────────────
# Deployment dir (.env with the Helios secrets, tinyauth state) and the code checkout it builds.
HELIOS_DIR=/srv/helios
HELIOS_SRC=/srv/workspace/projects/helios
# HOME whose .claude/.codex/.grok logins fitness-sync reads (quota panel) and whose .hermes/ holds bws
# HELIOS_CLI_HOME=/srv/orca

# ── Discord backup bot (optional, `command-center discord-backup install`) ──
# Releases, bws.env (BWS_ACCESS_TOKEN, copied from HELIOS_CLI_HOME/.hermes/.env) and var/ (archives).
# The bot token and the archive key stay in Bitwarden; nothing secret goes here.
DISCORD_BACKUP_DIR=/srv/discord-backup
# Branch or tag `deploy` builds (default ops/discordjs14-production); repo fetched as hermes (gh).
# DISCORD_BACKUP_REF=ops/discordjs14-production
# DISCORD_BACKUP_REPO=https://github.com/LOUKASSS/discord-backup-bot.git

# ── herdr (optional, `command-center herdr install`; systemd herdr.service, user hermes) ──
HERDR_MEM_LIMIT=4g

# ── Resources (VPS 8 vCPU / 16 GB: agent gets 10g + 6 CPUs, the rest stays for
#    host, traefik, obsidian-sync and Orca) ──
AGENT_MEM_LIMIT=10g
AGENT_CPUS=6
# traefik 256m, obsidian-sync 1g are fixed in compose. Orca runs on the host (orca.service,
# MemoryMax=ORCA_MEM_LIMIT).
ORCA_MEM_LIMIT=3g
POSTGRES_MEM_LIMIT=512m
TZ=Europe/Paris

# Automation flags (files in this directory, not variables): touch .maintenance to pause heal.sh;
# .update-hold is written by `update.sh rollback` and by the automatic rollback of a failed
# update, removed by `update.sh resume` or a successful `update.sh --force`.
# Timer times (backup 03:00, update Sun 03:30, reboot 02:00) follow the HOST timezone; TZ below
# only applies to the containers and restic.

# ── Backups → Backblaze B2 (backup.sh setup fills these) ─────────
# Bucket + application key restricted to it (listBuckets, listFiles, readFiles, writeFiles, deleteFiles)
B2_BUCKET=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
# Repository encryption password (generated). LOSING IT = LOSING THE BACKUPS. Keep a copy elsewhere.
RESTIC_PASSWORD=
# Defaults to b2:$B2_BUCKET:hermes
RESTIC_REPOSITORY=
RESTIC_IMAGE=restic/restic:latest
