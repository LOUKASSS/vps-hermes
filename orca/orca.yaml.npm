# Orca workspace setup — https://www.onorca.dev/docs/model/worktrees
# Source: LOUKASSS/command-center orca/orca.yaml.npm (copied into each npm repo).
# Runs once in every new Orca worktree; ORCA_ROOT_PATH = main checkout, ORCA_WORKTREE_PATH = new one.
scripts:
  setup: |
    npm ci --prefer-offline --no-audit --no-fund
# Agents start right away; npm ci (~15 s) runs alongside in the Setup tab. wait-for-setup hung the
# agent for 2 h whenever the Setup tab was closed (the gate only opens on Orca's completion marker).
setupAgentStartupPolicy: start-immediately
